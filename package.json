{
  "name": "frank",
  "version": "1.0.0",
  "description": "a visual AI development application",
  "main": "index.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron . --inspect=5858 --trace-deprecation --trace-warnings",
    "test": "playwright test",
    "test:ci": "playwright test --reporter=html --output=test-results/",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "build": {
    "appId": "com.myapp",
    "productName": "frank",
    "files": [
      "index.js",
      "preload.js",
      "public/**/*",
      "node_modules/**/*"
    ]
  },
  "keywords": [],
  "author": "Jaden Lee",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "electron": "latest"
  },
  "allowScripts": {
    "electron@41.3.0": true
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
